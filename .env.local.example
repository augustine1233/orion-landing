# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored — it stays on this machine only.

# GHL Private Integration Token for the Orion sub-account.
# Generate at: GHL → Settings → Private Integrations → Create new
GHL_PIT_TOKEN=pit-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GHL Location ID for the Orion sub-account.
# Find at: GHL → Settings → Business Profile → Location ID
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# GHL API version header (current as of 2026)
GHL_API_VERSION=2021-07-28
